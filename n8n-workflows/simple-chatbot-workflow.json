{
  "name": "Advanced AI Chatbot Workflow (OpenAI & Anthropic)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chatbot",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.provider }}",
              "value2": "anthropic"
            }
          ]
        }
      },
      "id": "provider-router",
      "name": "Is Anthropic?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": "={{ $json.model || 'gpt-4o' }}",
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "content": "You are a helpful and intelligent AI assistant powered by OpenAI via n8n."
            },
            {
              "role": "user",
              "content": "={{ $('Webhook Trigger').item.json.message }}"
            }
          ]
        },
        "options": {
          "temperature": 0.7
        }
      },
      "id": "openai-chat-node",
      "name": "OpenAI Chat",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [550, 200]
    },
    {
      "parameters": {
        "model": "={{ $json.model || 'claude-3-5-sonnet-20241022' }}",
        "prompt": "={{ $('Webhook Trigger').item.json.message }}",
        "options": {
          "system": "You are a helpful and intelligent AI assistant powered by Anthropic Claude via n8n.",
          "temperature": 0.7
        }
      },
      "id": "anthropic-chat-node",
      "name": "Anthropic Chat",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [550, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"provider\": \"{{ $json.provider || 'openai' }}\",\n  \"model\": \"{{ $json.model || 'default' }}\",\n  \"response\": \"{{ $json.choices ? $json.choices[0].message.content : $json.content[0].text }}\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\"\n}"
      },
      "id": "respond-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [820, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Is Anthropic?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Anthropic?": {
      "main": [
        [
          {
            "node": "Anthropic Chat",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "OpenAI Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anthropic Chat": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "2"
}